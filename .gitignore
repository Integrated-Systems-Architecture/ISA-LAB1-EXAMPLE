# FuseSoC build tree
/build/

# Vendored IP sources: fetched by `make vendor`, described by the
# .vendor.hjson files (which ARE committed, together with the .lock.hjson so
# the exact revision is reproducible).
/vendor/pulp_platform/common_cells/
/vendor/pulp_platform/tech_cells_generic/
/vendor/pulp_platform/register_interface/
/vendor/pulp_platform/obi/

# Generated by reggen (`make regs`) from data/cordic_accel.hjson
/rtl/cordic_accel_reg_pkg.sv
/rtl/cordic_accel_reg_top.sv
/sw/cordic_accel_regs.h

# Generated by the golden model (`make vectors`)
/vectors/*.hex
/vectors/config.txt

# Design Compiler outputs (regenerate with `make synth`)
/implementation/design_compiler/work/
/implementation/design_compiler/db/
/implementation/design_compiler/reports/
/implementation/design_compiler/netlist/
command.log
default.svf
*.svf
*.ddc

# Innovus outputs (regenerate with `make pnr`)
/implementation/innovus/artefacts/
/implementation/innovus/innovus.*
/implementation/innovus/.innovus*
/implementation/innovus/timingReports/

# Power analysis outputs (regenerate with `make power`)
/implementation/power_analysis/vcd/
/implementation/power_analysis/reports/

# Simulator leftovers
work/
transcript
vsim.wlf
*.fst
*.vcd
*.log
__pycache__/
