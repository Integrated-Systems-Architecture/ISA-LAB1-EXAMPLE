CAPI=2:
# FuseSoC core for the standalone CORDIC accelerator and its testbench.
#
#   fusesoc --cores-root . --cores-root vendor run --target sim        isa:lab1:cordic_accel
#   fusesoc --cores-root . --cores-root vendor run --target sim_questa isa:lab1:cordic_accel
#
# The Makefile wraps both (make sim / make questa). Read this file: it is the
# same .core format that pulls the accelerator into X-HEEP in Lab 3, and the
# `depend` list below is exactly the set of IPs `make vendor` fetched.

name: isa:lab1:cordic_accel:0.1.0
description: CORDIC accelerator with an OBI data port and a reggen CSR interface

filesets:
  rtl:
    files:
      - rtl/cordic_pkg.sv              # formats, atan ROM, saturating narrow
      - rtl/cordic_accel_types_pkg.sv  # own OBI / reg-interface structs
      - rtl/cordic_accel_reg_pkg.sv    # generated by reggen (`make regs`)
      - rtl/cordic_accel_reg_top.sv    # generated by reggen (`make regs`)
      - rtl/cordic_rot.sv              # the rotator, straight from the cookbook
      - rtl/cordic_accel.sv            # OBI manager + CSRs around the rotator
    file_type: systemVerilogSource
    depend:
      # No OBI package: the accelerator carries its own bus structs in
      # cordic_accel_types_pkg, because the SoC it is integrated into
      # already owns the name `obi_pkg` for a different OBI flavour.
      - pulp-platform.org::register_interface
      - pulp-platform.org::common_cells

  # The technology cells, in two flavours with the same module names. Every
  # target picks exactly one: behavioural models to simulate with, real
  # library cells to synthesise with. Mixing them, or synthesising the
  # behavioural ones, is how you end up with a netlist that means nothing.
  tech-generic:
    depend:
      - pulp-platform.org::tech_cells_generic

  tech-sg13g2:
    files:
      - implementation/tech/sg13g2/tc_clk_gating_sg13g2.sv  # -> sg13g2_lgcp_1
    file_type: systemVerilogSource

  # The memory wrapper, same pattern as the clock gate: one module name
  # (`sram_wrapper`), two implementations, the target picks one. NOT in the
  # filesets above, because the accelerator as shipped has no SRAM -- its
  # angle buffer is fifo_v3, which is flip-flops.
  #
  # The moment your accelerator wants a scratchpad -- a line buffer, a
  # coefficient store, a result buffer -- instantiate `sram_wrapper` in your
  # RTL and add ONE of these two to each target below:
  #
  #     sim, sim_questa, lint  ->  mem-generic
  #     synth                  ->  mem-sg13g2
  #
  # Synthesising the behavioural model instead does not fail. It builds the
  # array out of flip-flops: a 1024x32 memory becomes 32 kbit of flops plus
  # the decoding, tens of times the area of the macro and nowhere near its
  # speed. That silence is why the wrapper exists. See §10 of
  # implementation/design_compiler/README.md.
  mem-generic:
    files:
      - implementation/tech/generic/sram_wrapper_generic.sv   # -> tc_sram
    file_type: systemVerilogSource
    depend:
      - pulp-platform.org::tech_cells_generic

  mem-sg13g2:
    files:
      - implementation/tech/sg13g2/sram_wrapper_sg13g2.sv     # -> RM_IHPSG13_1P_...
    file_type: systemVerilogSource

  tb:
    files:
      - tb/tb_cordic_accel.sv
    file_type: systemVerilogSource
    depend:
      - pulp-platform.org::obi_test
      - pulp-platform.org::reg_test

targets:
  default: &default
    filesets: [rtl]

  # Verilator 5: the whole testbench is plain SystemVerilog, so --binary
  # --timing compiles it directly. No C++ harness.
  sim:
    <<: *default
    default_tool: verilator
    filesets: [rtl, tech-generic, tb]
    toplevel: tb_cordic_accel
    tools:
      verilator:
        mode: binary
        verilator_options:
          - --timing
          - --trace-fst
          # The vendored IPs are lint-clean for their own flow, not for ours.
          - -Wno-fatal

  # QuestaSim / ModelSim: same sources, same testbench, must agree.
  sim_questa:
    <<: *default
    default_tool: modelsim
    filesets: [rtl, tech-generic, tb]
    toplevel: tb_cordic_accel
    tools:
      modelsim:
        # The suppressed messages are all upstream-IP noise, not ours:
        #   2583   shift/width warnings inside the vendored IPs
        #   13314  an implicit-cast note from the reggen block
        #   13276  "Could not find field/method name (rready|reqpar|...)".
        #          The OBI_ASSIGN_* macros reference the optional OBI
        #          signals inside a branch selected by the config; with
        #          ObiDefaultConfig those fields do not exist and the branch
        #          is dead. Verilator prunes it, Questa still type-checks it
        #          and reports a *suppressible* error. Suppressing it is
        #          what pulp's own Questa flows do.
        #
        # -timescale gives every module that declares no `timeunit' the same
        # default. Without it Questa refuses to elaborate:
        #   ** Error: (vsim-3009) [TSCALE] - Module 'tb_cordic_accel' does not
        #   have a timeunit/timeprecision specification in effect, but other
        #   modules do.
        # "other modules" are the vendored IPs, which do declare one. Mixing
        # is the error; a uniform default removes it. 1ps precision matters
        # later: the gate-level runs annotate SDF delays in picoseconds.
        vlog_options: [-sv, -timescale, 1ns/1ps,
                       -suppress, 2583, -suppress, 13314, -suppress, 13276]

  # Logic synthesis with Synopsys Design Compiler.
  #
  # edalize starts dc_shell in build/<core>/synth-design_compiler/ and hands
  # our script the file list it derived from the `rtl` fileset -- which is why
  # the paths below climb three levels back out to the lab. Everything the
  # script itself needs (libraries, constraints) lives in
  # implementation/design_compiler/scripts/.
  synth:
    <<: *default
    default_tool: design_compiler
    filesets: [rtl, tech-sg13g2]
    toplevel: cordic_accel
    tools:
      design_compiler:
        script_dir: ../../../implementation/design_compiler/scripts
        dc_script: dc_script.tcl
        report_dir: ../../../implementation/design_compiler/reports
        # The real library setup is in dc_script.tcl, which is sourced after
        # edalize writes these; it selects the PVT corner and compiles the
        # PDK's Liberty into .db on demand.
        libs: dw_foundation.sldb

  # Lint only, no simulation: the quickest feedback while writing RTL.
  lint:
    <<: *default
    default_tool: verilator
    filesets: [rtl, tech-generic]
    toplevel: cordic_accel
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall, -Wno-fatal]
